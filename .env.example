# Lumira - Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ===========================================
# API Keys
# ===========================================

# Unsplash API (Required)
# Get your keys at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here

# Pexels API (Optional)
# Get your key at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Hugging Face Token (Optional)
# Only needed for private/gated models
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_token_here

# Web API key (production) — when set, protects admin and generation endpoints
# Pass as X-API-Key header from clients. Railway sets this automatically.
# RAILWAY_API_KEY=your_secret_api_key_here

# Comma-separated browser origins for CORS and WebSocket validation
# ALLOWED_ORIGINS=https://lumira.example.com,https://www.lumira.example.com

# WebSocket limits (optional)
# WS_MAX_CONNECTIONS=100
# WS_MAX_MESSAGES_PER_MINUTE=60

# ===========================================
# Database Configuration
# ===========================================

# SQLite (default)
DATABASE_URL=sqlite:///./data/lumira.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/lumira

# ===========================================
# Application Settings
# ===========================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Device: cuda, mps, cpu
DEVICE=cuda

# Data type: float16, float32
DTYPE=float16

# ===========================================
# Model Configuration
# ===========================================

# Base model ID
MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0

# LoRA settings (optional)
# LORA_PATH=models/lora/my_style
# LORA_SCALE=0.8

# ===========================================
# Generation Settings
# ===========================================

# Image dimensions
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# Generation parameters
NUM_INFERENCE_STEPS=30
GUIDANCE_SCALE=7.5
NUM_VARIATIONS=3

# Negative prompt
NEGATIVE_PROMPT="blurry, low quality, distorted, ugly, deformed, watermark, text"

# ===========================================
# Scheduling Settings
# ===========================================

# Enable automated scheduling
SCHEDULING_ENABLED=true

# Timezone
TIMEZONE=America/Los_Angeles

# Daily creation schedule
DAILY_CREATION_ENABLED=true
DAILY_CREATION_HOUR=9
DAILY_CREATION_MINUTE=0

# ===========================================
# Curation Settings
# ===========================================

# Enable automatic curation
CURATION_ENABLED=true

# Quality threshold (0.0-1.0)
QUALITY_THRESHOLD=0.6

# Keep top N images from batch
KEEP_TOP_N=2

# ===========================================
# Web Interface
# ===========================================

# Web server host
WEB_HOST=0.0.0.0

# Web server port
WEB_PORT=8000

# Enable hot reload (development only)
WEB_RELOAD=false

# ===========================================
# Storage Settings
# ===========================================

# Gallery directory
GALLERY_PATH=gallery

# Models cache directory
MODELS_PATH=models

# Logs directory
LOGS_PATH=logs

# ===========================================
# Security Settings (Future)
# ===========================================

# API rate limiting
# RATE_LIMIT_PER_MINUTE=60

# JWT secret (generate with: openssl rand -hex 32)
# JWT_SECRET_KEY=your_secret_key_here

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ===========================================
# Performance Settings
# ===========================================

# Enable attention slicing
ENABLE_ATTENTION_SLICING=true

# Enable VAE slicing
ENABLE_VAE_SLICING=true

# ===========================================
# Optional Integrations (Future)
# ===========================================

# Email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=Lumira <noreply@yourapp.com>

# Webhook URL for notifications
# WEBHOOK_URL=https://your-webhook-url.com

# Cloud storage (S3, GCS, etc.)
# CLOUD_STORAGE_PROVIDER=s3
# CLOUD_STORAGE_BUCKET=your-bucket-name
# CLOUD_STORAGE_ACCESS_KEY=your_access_key
# CLOUD_STORAGE_SECRET_KEY=your_secret_key

# ===========================================
# Development Settings
# ===========================================

# Enable debug mode
DEBUG=false

# Profiling
ENABLE_PROFILING=false

# Testing
TESTING=false


# ===========================================
# Social Media Credentials
# ===========================================

# Twitter / X  (get keys at https://developer.twitter.com)
# SOCIAL__TWITTER_API_KEY=your_api_key
# SOCIAL__TWITTER_API_SECRET=your_api_secret
# SOCIAL__TWITTER_ACCESS_TOKEN=your_access_token
# SOCIAL__TWITTER_ACCESS_SECRET=your_access_secret
# SOCIAL__TWITTER_BEARER_TOKEN=your_bearer_token

# Instagram (uses instagrapi - username/password auth)
# SOCIAL__INSTAGRAM_USERNAME=your_handle
# SOCIAL__INSTAGRAM_PASSWORD=your_password
# SOCIAL__INSTAGRAM_SESSION_FILE=data/instagram_session.json

# Bluesky
# SOCIAL__BLUESKY_HANDLE=yourhandle.bsky.social
# SOCIAL__BLUESKY_PASSWORD=your_app_password

# Whether to post automatically above quality threshold
# SOCIAL__ENABLED=false
# SOCIAL__AUTO_SHARE=false
# SOCIAL__SHARE_THRESHOLD=0.3


# ===========================================
# Observability / Monitoring
# ===========================================

# Sentry error tracking (https://sentry.io)
# SENTRY_DSN=https://your_key@sentry.io/project_id

# Replicate API (cloud generation fallback / img2img)
# REPLICATE_API_TOKEN=r8_your_replicate_token_here

# Magica / Galaxy AI (preferred cloud multi-model backend for studio + Railway)
# Get a key at https://app.magica.com → Settings → API Keys
# MAGICA_API_KEY=gx_your_magica_key_here
# Optional Magica overrides:
# MAGICA_BASE_URL=https://api.magica.com/api
# LUMIRA_MAGICA_DAILY_MAX_IMAGES=200
# LUMIRA_MAGICA_DAILY_MAX_AUDIO=20
# LUMIRA_MAGICA_DAILY_MAX_VIDEO=20
# LUMIRA_AUTO_SOUNDTRACK=0
# LUMIRA_FORCE_LOCAL_WEB=0


# ===========================================
# Redis (optional caching / queue backend)
# ===========================================

# Redis connection URL (required for queue worker)
# REDIS_URL=redis://localhost:6379/0


# ===========================================
# Graph Memory (FalkorDB)
# ===========================================

# FalkorDB connection (optional - enables graph-based memory)
# GRAPH_MEMORY__HOST=localhost
# GRAPH_MEMORY__PORT=6380
